---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBand from '../../components/sections/CtaBand.astro';
import Card from '../../components/ui/Card.astro';
import Reveal from '../../components/ui/Reveal.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';

import { DEFAULT_LOCALE, localePath } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';
import { entrySlug, getLocalisedCollection } from '../../lib/collections';
import { readingTimeMinutes } from '../../lib/reading-time';

const locale = DEFAULT_LOCALE;
const t = useTranslations(locale);

const posts = (await getLocalisedCollection('blog', locale)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);

const dateFormatter = new Intl.DateTimeFormat(locale, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const jsonLd = [
  {
    '@type': 'Blog',
    name: t('blogPage.seoTitle'),
    description: t('blogPage.seoDescription'),
    url: new URL(localePath(locale, '/blog/'), Astro.site).href,
    publisher: { '@id': `${Astro.site?.href}#organization` },
  },
];
---

<BaseLayout
  title={t('blogPage.seoTitle')}
  description={t('blogPage.seoDescription')}
  path="/blog/"
  jsonLd={jsonLd}
>
  <section class="on-ink">
    <div class="container-site page-hero">
      <SectionHeader
        eyebrow={t('blogPage.eyebrow')}
        title={t('blogPage.title')}
        lead={t('blogPage.lead')}
        tone="ink"
        as="h1"
      />
    </div>
  </section>

  <section class="container-site section-y">
    <ul class="posts">
      {
        posts.map((post, index) => (
          <Reveal as="li" delay={index * 70}>
            <Card
              href={localePath(locale, `/blog/${entrySlug(post.id)}/`)}
              ariaLabel={`${post.data.title} — ${t('cta.readArticle')}`}
              class="h-full"
            >
              <p class="post__meta">
                <time datetime={post.data.pubDate.toISOString()}>
                  {dateFormatter.format(post.data.pubDate)}
                </time>
                <span aria-hidden="true">·</span>
                <span>{t('common.readingTime', { minutes: readingTimeMinutes(post.body ?? '') })}</span>
              </p>

              <h2 class="post__title">{post.data.title}</h2>
              <p class="post__description">{post.data.description}</p>

              <ul class="post__tags">
                {post.data.tags.map((tag) => (
                  <li>{tag}</li>
                ))}
              </ul>

              <span class="post__more">{t('cta.readArticle')}</span>
            </Card>
          </Reveal>
        ))
      }
    </ul>
  </section>

  <CtaBand locale={locale} title={t('blogPage.ctaTitle')} lead={t('blogPage.ctaLead')} />
</BaseLayout>

<style>
  .page-hero {
    padding-block: clamp(3.5rem, 3rem + 3vw, 6rem);
  }

  .posts {
    display: grid;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .post__meta {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin: 0;
    font-size: 0.8125rem;
    color: var(--color-slate);
  }

  .post__title {
    margin: 1rem 0 0;
    font-size: 1.5rem;
    font-weight: 400;
    line-height: 1.25;
  }

  .post__description {
    margin: 0.875rem 0 0;
    font-size: 0.9375rem;
    color: var(--color-slate);
  }

  .post__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .post__tags li {
    padding: 0.25rem 0.625rem;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-pill);
    font-size: 0.75rem;
    color: var(--color-slate);
  }

  .post__more {
    margin-block-start: auto;
    padding-block-start: 1.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-cobalt);
  }

  @media (width >= 48rem) {
    .posts {
      grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr));
    }
  }
</style>
