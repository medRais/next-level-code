---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBand from '../../components/sections/CtaBand.astro';
import Glyph from '../../components/brand/Glyph.astro';
import Reveal from '../../components/ui/Reveal.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';

import { DEFAULT_LOCALE, localePath } from '../../i18n/config';
import { useContent, useTranslations } from '../../i18n/ui';

const locale = DEFAULT_LOCALE;
const t = useTranslations(locale);
const c = useContent(locale);

const phases = c('howWeWorkPage.phases.items');
const commitments = c('howWeWorkPage.commitments.items');
const securityPractices = c('howWeWorkPage.security.items');
const cadence = c('howWeWorkPage.communication.items');

const jsonLd = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: t('site.name'),
        item: new URL(localePath(locale, '/'), Astro.site).href,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: t('howWeWorkPage.eyebrow'),
        item: new URL(localePath(locale, '/how-we-work/'), Astro.site).href,
      },
    ],
  },
];
---

<BaseLayout
  title={t('howWeWorkPage.seoTitle')}
  description={t('howWeWorkPage.seoDescription')}
  path="/how-we-work/"
  jsonLd={jsonLd}
>
  <section class="on-ink">
    <div class="container-site page-hero">
      <SectionHeader
        eyebrow={t('howWeWorkPage.eyebrow')}
        title={t('howWeWorkPage.title')}
        lead={t('howWeWorkPage.lead')}
        tone="ink"
        as="h1"
      />
    </div>
  </section>

  <!-- Delivery stages -->
  <section class="container-site section-y">
    <SectionHeader
      eyebrow={t('howWeWorkPage.phases.eyebrow')}
      title={t('howWeWorkPage.phases.title')}
    />

    <ol class="phases">
      {
        phases.map((phase, index) => (
          <Reveal as="li" delay={index * 70}>
            <div class="phase">
              <span class="phase__index">{String(index + 1).padStart(2, '0')}</span>
              <div class="phase__content">
                <h3 class="phase__title">{phase.title}</h3>
                <p class="phase__body">{phase.body}</p>
                <p class="phase__output">
                  <Glyph size="0.6875rem" weight="hairline" class="text-cobalt" />
                  <span>{phase.output}</span>
                </p>
              </div>
            </div>
          </Reveal>
        ))
      }
    </ol>
  </section>

  <!-- Quality commitments -->
  <section class="tinted">
    <div class="container-site section-y">
      <SectionHeader
        eyebrow={t('howWeWorkPage.commitments.eyebrow')}
        title={t('howWeWorkPage.commitments.title')}
      />

      <div class="commitments">
        {
          commitments.map((commitment, index) => (
            <Reveal delay={index * 70}>
              <h3 class="commitment__title">{commitment.title}</h3>
              <p class="commitment__body">{commitment.body}</p>
            </Reveal>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Security -->
  <section class="container-site section-y">
    <SectionHeader
      eyebrow={t('howWeWorkPage.security.eyebrow')}
      title={t('howWeWorkPage.security.title')}
    />

    <ul class="practices">
      {
        securityPractices.map((practice, index) => (
          <Reveal as="li" delay={index * 50} class="practice">
            <Glyph size="0.75rem" weight="hairline" class="mt-2 text-cobalt" />
            <span>{practice}</span>
          </Reveal>
        ))
      }
    </ul>
  </section>

  <!-- Cadence -->
  <section class="on-ink">
    <div class="container-site section-y">
      <SectionHeader
        eyebrow={t('howWeWorkPage.communication.eyebrow')}
        title={t('howWeWorkPage.communication.title')}
        lead={t('howWeWorkPage.communication.body')}
        tone="ink"
      />

      <div class="cadence">
        {
          cadence.map((item, index) => (
            <Reveal delay={index * 70}>
              <h3 class="cadence__title">{item.title}</h3>
              <p class="cadence__body">{item.body}</p>
            </Reveal>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand
    locale={locale}
    title={t('howWeWorkPage.ctaTitle')}
    lead={t('howWeWorkPage.ctaLead')}
  />
</BaseLayout>

<style>
  .page-hero {
    padding-block: clamp(3.5rem, 3rem + 3vw, 6rem);
  }

  .tinted {
    /* No background tint here. A 3% ink wash reads as #F2F3F5, which drops
     the mandated slate secondary text from 4.59:1 to 4.28:1 — under AA.
     Section rhythm comes from hairline rules and the ink sections
     instead, which keeps both mandated colour tokens exactly as
     specified. See AGENTS.md §6.2 and §8. */
    border-block: 1px solid var(--color-hairline);
  }

  /* ── Phases ────────────────────────────────────────────────────────────── */
  .phases {
    margin: 3.5rem 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .phase {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1.5rem;
    padding-block: 2.25rem;
    border-block-start: 1px solid var(--color-hairline);
  }

  .phase__index {
    font-family: var(--font-display);
    font-size: 0.8125rem;
    letter-spacing: 0.2em;
    color: var(--color-cobalt);
    padding-block-start: 0.375rem;
  }

  .phase__title {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 400;
  }

  .phase__body {
    margin: 0.75rem 0 0;
    color: var(--color-slate);
    max-inline-size: 62ch;
  }

  /* The stage's deliverable, called out so each one is judgeable. */
  .phase__output {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 1.25rem 0 0;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-ink);
  }

  /* ── Commitments ───────────────────────────────────────────────────────── */
  .commitments {
    display: grid;
    gap: 2.5rem;
    margin-block-start: 3.5rem;
  }

  .commitment__title {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 400;
    padding-block-start: 1.25rem;
    border-block-start: 1px solid var(--color-hairline-strong);
  }

  .commitment__body {
    margin: 0.75rem 0 0;
    font-size: 0.9375rem;
    color: var(--color-slate);
  }

  /* ── Security ──────────────────────────────────────────────────────────── */
  .practices {
    margin: 3rem 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-inline-size: 70ch;
  }

  .practice {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
    color: var(--color-slate);
  }

  /* ── Cadence ───────────────────────────────────────────────────────────── */
  .cadence {
    display: grid;
    gap: 2.5rem;
    margin-block-start: 3.5rem;
  }

  .cadence__title {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-eyebrow);
    font-weight: 500;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-cobalt-light);
  }

  .cadence__body {
    margin: 0.875rem 0 0;
    color: var(--color-mist);
  }

  @media (width >= 48rem) {
    .phase {
      grid-template-columns: 4rem minmax(0, 1fr);
      gap: 2rem;
    }

    .commitments,
    .cadence {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 3rem 2.5rem;
    }
  }

  @media (width >= 64rem) {
    .cadence {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
