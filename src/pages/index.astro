---
// Foundation preview. Replaced by the real home page in Phase 3.
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';
import Counter from '../components/ui/Counter.astro';
import Reveal from '../components/ui/Reveal.astro';
import Rule from '../components/ui/Rule.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import Accordion from '../components/ui/Accordion.astro';
import Glyph from '../components/brand/Glyph.astro';
import { DEFAULT_LOCALE } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import { CLIENT_PROJECTS_DELIVERED, CLIENT_REFERENCES, FOUNDED_YEAR } from '../data/company';

const t = useTranslations(DEFAULT_LOCALE);

const demoCards = [
  { title: 'Custom software', body: 'Web, mobile and cloud systems built to run in production.' },
  { title: 'AI solutions', body: 'LLM applications, autonomous agents, RAG and computer vision.' },
  { title: 'APIs and products', body: 'Productised capabilities your teams can integrate in days.' },
];
---

<BaseLayout description={t('site.description')} path="/">
  <section class="on-ink">
    <div class="container-site section-y">
      <div>
        <Glyph size="2.5rem" animated class="text-porcelain" />
        <h1 class="text-display-1 text-porcelain mt-8" data-hero-item style="--hero-delay: 320ms;">
          {t('site.tagline')}
        </h1>
        <p class="text-lead text-mist mt-6 max-w-2xl" data-hero-item style="--hero-delay: 440ms;">
          {t('footer.pitch')}
        </p>
        <div class="mt-10 flex flex-wrap gap-4" data-hero-item style="--hero-delay: 560ms;">
          <Button href="/contact/" size="lg" tone="ink">{t('cta.primary')}</Button>
          <Button href="/products/" size="lg" variant="outline" tone="ink">
            {t('cta.secondary')}
          </Button>
        </div>
      </div>
    </div>
  </section>

  <section class="container-site section-y">
    <SectionHeader
      eyebrow="Foundation"
      title="Component primitives"
      lead="Everything below is driven by the design tokens and the translation dictionary. No component holds a hard-coded string."
    />

    <Rule class="mt-10" />

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        demoCards.map((card, index) => (
          <Reveal delay={index * 90}>
            <Card href="/services/" class="h-full">
              <h3 class="text-display-3">{card.title}</h3>
              <p class="text-slate mt-3">{card.body}</p>
            </Card>
          </Reveal>
        ))
      }
    </div>
  </section>

  <section class="on-ink">
    <div class="container-site section-y">
      <div class="grid gap-10 sm:grid-cols-3">
        <Counter value={FOUNDED_YEAR} label={t('metrics.founded')} tone="ink" animate={false} />
        <Counter
          value={CLIENT_PROJECTS_DELIVERED}
          label={t('metrics.projectsDelivered')}
          tone="ink"
        />
        <Counter value={CLIENT_REFERENCES} label={t('metrics.clientReferences')} tone="ink" />
      </div>
    </div>
  </section>

  <section class="container-site section-y">
    <SectionHeader eyebrow="FAQ" title="Accordion" as="h2" />
    <div class="mt-8 max-w-3xl">
      <Accordion question="Does this work without JavaScript?" open>
        <p>
          Yes. Reveals, the header behaviour and the counters are enhancements. With scripting off
          the page renders complete and static.
        </p>
      </Accordion>
      <Accordion question="What happens under reduced motion?">
        <p>Every animation is disabled. Nothing moves, and no content is hidden.</p>
      </Accordion>
    </div>
  </section>
</BaseLayout>
