---
/**
 * Case study detail page.
 *
 * Routes come from the content collection across every published locale, so
 * a translated case study publishes its own page with no change here.
 */

import type { GetStaticPaths } from 'astro';
import type { CollectionEntry } from 'astro:content';

import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBand from '../../components/sections/CtaBand.astro';
import ClientLogo from '../../components/ui/ClientLogo.astro';
import Eyebrow from '../../components/ui/Eyebrow.astro';
import Glyph from '../../components/brand/Glyph.astro';
import Reveal from '../../components/ui/Reveal.astro';

import { PUBLISHED_LOCALES, localePath, type LocaleCode } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';
import { entrySlug, getLocalisedCollection } from '../../lib/collections';

/**
 * Declared as a type alias rather than an interface: Astro's
 * `GetStaticPathsItem['props']` expects an implicit index signature, which
 * type aliases get and interfaces do not.
 */
type Props = {
  entry: CollectionEntry<'work'>;
  locale: LocaleCode;
  previous: CollectionEntry<'work'> | null;
  next: CollectionEntry<'work'> | null;
};

export const getStaticPaths: GetStaticPaths = async () => {
  const paths: Array<{ params: { slug: string }; props: Props }> = [];

  for (const locale of PUBLISHED_LOCALES) {
    const entries = await getLocalisedCollection('work', locale);

    entries.forEach((entry, index) => {
      paths.push({
        params: { slug: entrySlug(entry.id) },
        props: {
          entry,
          locale,
          // Neighbours are resolved here, where the ordered list is already
          // in hand, rather than re-queried per page.
          previous: entries[index - 1] ?? null,
          next: entries[index + 1] ?? null,
        },
      });
    });
  }

  return paths;
};

const { entry, locale, previous, next } = Astro.props as Props;
const { data } = entry;

const t = useTranslations(locale);

const services = await getLocalisedCollection('services', locale);
const relatedServices = services.filter((service) =>
  data.services.includes(entrySlug(service.id)),
);

const heading = data.project ? `${data.client} — ${data.project}` : data.client;

const jsonLd = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: t('site.name'),
        item: new URL(localePath(locale, '/'), Astro.site).href,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: t('workPage.eyebrow'),
        item: new URL(localePath(locale, '/work/'), Astro.site).href,
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: heading,
        item: new URL(localePath(locale, `/work/${entrySlug(entry.id)}/`), Astro.site).href,
      },
    ],
  },
];
---

<BaseLayout
  title={data.seo.title}
  description={data.seo.description}
  path={`/work/${entrySlug(entry.id)}/`}
  locale={locale}
  jsonLd={jsonLd}
>
  <article>
    <!-- Header -->
    <header class="case-hero on-ink">
      <div class="container-site case-hero__inner">
        <a class="case-hero__back" href={localePath(locale, '/work/')}>
          ← {t('workPage.backToWork')}
        </a>

        <Eyebrow tone="ink" class="mt-8">{data.sector}</Eyebrow>

        <h1 class="case-hero__title">
          {data.client}
          {data.project && <span class="case-hero__project">{data.project}</span>}
        </h1>

        <p class="case-hero__summary">{data.summary}</p>
      </div>
    </header>

    <!-- The three-part narrative the brief specifies -->
    <div class="container-site section-y case-body">
      <div class="case-body__main">
        <Reveal>
          <section class="case-section">
            <h2 class="case-section__heading">{t('workPage.contextHeading')}</h2>
            <p class="case-section__text">{data.context}</p>
          </section>
        </Reveal>

        <Reveal>
          <section class="case-section">
            <h2 class="case-section__heading">{t('workPage.solutionHeading')}</h2>
            <p class="case-section__text">{data.solution}</p>
          </section>
        </Reveal>

        <Reveal>
          <section class="case-section">
            <h2 class="case-section__heading">{t('workPage.benefitsHeading')}</h2>
            <ul class="benefits">
              {
                data.benefits.map((benefit) => (
                  <li class="benefit">
                    <Glyph size="0.75rem" weight="hairline" class="benefit__mark" />
                    <span>{benefit}</span>
                  </li>
                ))
              }
            </ul>
          </section>
        </Reveal>
      </div>

      <!-- Facts panel -->
      <aside class="case-aside">
        <div class="case-aside__logo">
          <ClientLogo
            logo={data.logo}
            name={data.client}
            treatment={data.logoTreatment}
          />
        </div>

        <dl class="facts">
          <div class="fact">
            <dt>{t('workPage.sectorLabel')}</dt>
            <dd>{data.sector}</dd>
          </div>
          {
            data.project && (
              <div class="fact">
                <dt>{t('workPage.projectLabel')}</dt>
                <dd>{data.project}</dd>
              </div>
            )
          }
        </dl>

        {
          relatedServices.length > 0 && (
            <div class="case-aside__services">
              <h2 class="case-aside__heading">{t('workPage.servicesHeading')}</h2>
              <ul class="service-links">
                {relatedServices.map((service) => (
                  <li>
                    <a
                      class="service-link"
                      href={localePath(locale, `/services/${entrySlug(service.id)}/`)}
                    >
                      {service.data.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </aside>
    </div>

    <!-- Neighbours -->
    {
      (previous || next) && (
        <nav class="container-site case-nav" aria-label={t('workPage.eyebrow')}>
          {previous ? (
            <a class="case-nav__link" href={localePath(locale, `/work/${entrySlug(previous.id)}/`)}>
              <span class="case-nav__label">← {t('workPage.previous')}</span>
              <span class="case-nav__title">{previous.data.client}</span>
            </a>
          ) : (
            <span />
          )}

          {next && (
            <a
              class="case-nav__link case-nav__link--next"
              href={localePath(locale, `/work/${entrySlug(next.id)}/`)}
            >
              <span class="case-nav__label">{t('workPage.next')} →</span>
              <span class="case-nav__title">{next.data.client}</span>
            </a>
          )}
        </nav>
      )
    }
  </article>

  <CtaBand locale={locale} title={t('workPage.ctaTitle')} lead={t('workPage.ctaLead')} />
</BaseLayout>

<style>
  /* ── Header ────────────────────────────────────────────────────────────── */
  .case-hero__inner {
    padding-block: clamp(3rem, 2.5rem + 3vw, 5rem);
    max-inline-size: 56rem;
  }

  .case-hero__back {
    font-size: 0.875rem;
    color: var(--color-mist);
    text-decoration: none;
    transition: color var(--duration-micro) var(--ease-swift);
  }

  .case-hero__back:hover {
    color: var(--color-porcelain);
  }

  .case-hero__title {
    margin: 1rem 0 0;
    font-size: var(--text-display-1);
    font-weight: 300;
    line-height: 1;
    letter-spacing: 0.01em;
  }

  .case-hero__project {
    display: block;
    margin-block-start: 0.75rem;
    font-size: 0.4em;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-cobalt-light);
  }

  .case-hero__summary {
    margin: 1.75rem 0 0;
    font-size: var(--text-lead);
    line-height: 1.6;
    color: var(--color-mist);
    max-inline-size: 52ch;
  }

  /* ── Body ──────────────────────────────────────────────────────────────── */
  .case-body {
    display: grid;
    gap: 3.5rem;
    align-items: start;
  }

  /* Spacing lives on the container, not on adjacent siblings: each section is
     wrapped in a Reveal, so `.case-section + .case-section` never matches. */
  .case-body__main {
    display: flex;
    flex-direction: column;
    gap: 3.25rem;
  }

  .case-section__heading {
    font-family: var(--font-body);
    font-size: var(--text-eyebrow);
    font-weight: 500;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-cobalt);
    margin: 0;
  }

  .case-section__text {
    margin: 1rem 0 0;
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--color-ink);
    max-inline-size: 62ch;
  }

  .benefits {
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-inline-size: 62ch;
  }

  /* The ≡ standing in for a bullet — the signature used at its smallest. */
  .benefit {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    align-items: start;
    color: var(--color-slate);
  }

  .benefit__mark {
    margin-block-start: 0.5rem;
    color: var(--color-cobalt);
  }

  /* ── Aside ─────────────────────────────────────────────────────────────── */
  .case-aside {
    padding: 2rem;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-card);
    background-color: color-mix(in oklab, var(--color-ink) 2%, var(--color-porcelain));
  }

  .case-aside__logo {
    display: flex;
    block-size: 3rem;
    margin-block-end: 2rem;
  }

  .facts {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .fact dt {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-slate);
  }

  .fact dd {
    margin: 0.375rem 0 0;
    font-size: 0.9375rem;
    color: var(--color-ink);
  }

  .case-aside__services {
    margin-block-start: 2rem;
    padding-block-start: 2rem;
    border-block-start: 1px solid var(--color-hairline);
  }

  .case-aside__heading {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-slate);
    margin: 0;
  }

  .service-links {
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .service-link {
    font-size: 0.9375rem;
    color: var(--color-cobalt);
    text-decoration: none;
  }

  .service-link:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  /* ── Neighbours ────────────────────────────────────────────────────────── */
  .case-nav {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 2rem 4rem;
    border-block-start: 1px solid var(--color-hairline);
  }

  .case-nav__link {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    text-decoration: none;
  }

  .case-nav__link--next {
    text-align: end;
    margin-inline-start: auto;
  }

  .case-nav__label {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-slate);
  }

  .case-nav__title {
    font-family: var(--font-display);
    font-size: 1.125rem;
    color: var(--color-ink);
  }

  .case-nav__link:hover .case-nav__title {
    color: var(--color-cobalt);
  }

  @media (width >= 64rem) {
    .case-body {
      grid-template-columns: minmax(0, 1fr) 20rem;
      gap: 5rem;
    }
  }
</style>
