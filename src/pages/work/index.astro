---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBand from '../../components/sections/CtaBand.astro';
import ClientLogo from '../../components/ui/ClientLogo.astro';
import Card from '../../components/ui/Card.astro';
import Reveal from '../../components/ui/Reveal.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';

import { DEFAULT_LOCALE, localePath } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';
import { entrySlug, getLocalisedCollection } from '../../lib/collections';

const locale = DEFAULT_LOCALE;
const t = useTranslations(locale);

const references = await getLocalisedCollection('work', locale);

/** Breadcrumbs give search results a readable hierarchy rather than a bare URL. */
const jsonLd = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: t('site.name'),
        item: new URL(localePath(locale, '/'), Astro.site).href,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: t('workPage.eyebrow'),
        item: new URL(localePath(locale, '/work/'), Astro.site).href,
      },
    ],
  },
];
---

<BaseLayout
  title={t('workPage.seoTitle')}
  description={t('workPage.seoDescription')}
  path="/work/"
  jsonLd={jsonLd}
>
  <section class="container-site section-y">
    <SectionHeader
      eyebrow={t('workPage.eyebrow')}
      title={t('workPage.title')}
      lead={t('workPage.lead')}
      as="h1"
    />
  </section>

  <section class="container-site pb-24">
    <ul class="work-grid">
      {
        references.map((entry, index) => (
          <Reveal as="li" delay={index * 70}>
            <Card href={localePath(locale, `/work/${entrySlug(entry.id)}/`)} class="h-full">
              <div class="work-item__logo">
                <ClientLogo
                  logo={entry.data.logo}
                  name={entry.data.client}
                  treatment={entry.data.logoTreatment}
                />
              </div>

              <span class="work-item__sector">{entry.data.sector}</span>

              <h2 class="work-item__title">
                {entry.data.client}
                {entry.data.project && (
                  <span class="work-item__project">{entry.data.project}</span>
                )}
              </h2>

              <p class="work-item__summary">{entry.data.summary}</p>
              <span class="work-item__more">{t('cta.readCaseStudy')}</span>
            </Card>
          </Reveal>
        ))
      }
    </ul>
  </section>

  <CtaBand locale={locale} />
</BaseLayout>

<style>
  .work-grid {
    display: grid;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* The logo sits in a fixed-height slot so cards line up regardless of each
     mark's aspect ratio. */
  .work-item__logo {
    display: flex;
    align-items: center;
    justify-content: start;
    block-size: 3rem;
    margin-block-end: 1.75rem;
  }

  .work-item__sector {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-slate);
  }

  .work-item__title {
    margin: 0.875rem 0 0;
    font-size: 1.5rem;
    font-weight: 400;
    line-height: 1.2;
  }

  .work-item__project {
    display: block;
    margin-block-start: 0.25rem;
    font-size: 1rem;
    color: var(--color-slate);
  }

  .work-item__summary {
    margin: 0.875rem 0 0;
    color: var(--color-slate);
  }

  .work-item__more {
    margin-block-start: auto;
    padding-block-start: 1.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-cobalt);
  }

  @media (width >= 48rem) {
    .work-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (width >= 80rem) {
    .work-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
