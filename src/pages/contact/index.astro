---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactForm from '../../components/forms/ContactForm.astro';
import Accordion from '../../components/ui/Accordion.astro';
import Glyph from '../../components/brand/Glyph.astro';
import Reveal from '../../components/ui/Reveal.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';

import { DEFAULT_LOCALE, localePath } from '../../i18n/config';
import { useContent, useTranslations } from '../../i18n/ui';
import { CONTACT_EMAIL } from '../../data/company';

const locale = DEFAULT_LOCALE;
const t = useTranslations(locale);
const c = useContent(locale);

const expectations = c('contactPage.expect');
const faq = c('contactPage.faq');

const jsonLd = [
  {
    '@type': 'ContactPage',
    name: t('contactPage.seoTitle'),
    url: new URL(localePath(locale, '/contact/'), Astro.site).href,
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: { '@type': 'Answer', text: item.answer },
    })),
  },
];
---

<BaseLayout
  title={t('contactPage.seoTitle')}
  description={t('contactPage.seoDescription')}
  path="/contact/"
  jsonLd={jsonLd}
>
  <section class="on-ink">
    <div class="container-site page-hero">
      <SectionHeader
        eyebrow={t('contactPage.eyebrow')}
        title={t('contactPage.title')}
        lead={t('contactPage.lead')}
        tone="ink"
        as="h1"
      />
    </div>
  </section>

  <section class="container-site section-y">
    <div class="contact">
      <div class="contact__form">
        <h2 class="contact__heading">{t('contactPage.formHeading')}</h2>
        <ContactForm locale={locale} class="mt-8" />
      </div>

      <aside class="contact__aside">
        <div>
          <h2 class="contact__heading">{t('contactPage.expectHeading')}</h2>
          <ul class="expectations">
            {
              expectations.map((item) => (
                <li class="expectation">
                  <Glyph size="0.75rem" weight="hairline" class="mt-2 text-cobalt" />
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="direct">
          <h2 class="contact__heading">{t('contactPage.directHeading')}</h2>
          <p class="direct__row">
            <span class="direct__label">{t('contactPage.emailLabel')}</span>
            <a class="direct__value" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
          </p>
        </div>
      </aside>
    </div>
  </section>

  <!-- Commercial FAQ -->
  <section class="tinted">
    <div class="container-site section-y">
      <SectionHeader eyebrow={t('contactPage.faqEyebrow')} title={t('contactPage.faqTitle')} />

      <div class="faq">
        {
          faq.map((item, index) => (
            <Reveal delay={index * 50}>
              <Accordion question={item.question} open={index === 0}>
                <p>{item.answer}</p>
              </Accordion>
            </Reveal>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding-block: clamp(3.5rem, 3rem + 3vw, 6rem);
  }

  .tinted {
    background-color: color-mix(in oklab, var(--color-ink) 3%, var(--color-porcelain));
    border-block-start: 1px solid var(--color-hairline);
  }

  .contact {
    display: grid;
    gap: 3.5rem;
    align-items: start;
  }

  .contact__heading {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-eyebrow);
    font-weight: 500;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-slate);
  }

  .contact__aside {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .expectations {
    margin: 1.75rem 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .expectation {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
    font-size: 0.9375rem;
    color: var(--color-slate);
  }

  .direct__row {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    margin: 1.75rem 0 0;
  }

  .direct__label {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-slate);
  }

  .direct__value {
    font-size: 1.0625rem;
    color: var(--color-cobalt);
    text-decoration: none;
  }

  .direct__value:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .faq {
    margin-block-start: 3rem;
    max-inline-size: 48rem;
  }

  @media (width >= 64rem) {
    .contact {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      gap: 5rem;
    }
  }
</style>
