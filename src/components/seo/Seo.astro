---
/**
 * Per-page head metadata.
 *
 * Titles and descriptions are required rather than optional: the brief asks
 * for unique ones on every page, and a default that silently applies
 * site-wide is how pages end up sharing a description.
 *
 * hreflang links are emitted only once a second locale is published — cross
 * references pointing at pages that do not exist are worse than none.
 */

import {
  DEFAULT_LOCALE,
  IS_MULTILINGUAL,
  PUBLISHED_LOCALES,
  getLocale,
  localePath,
  type LocaleCode,
} from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';

interface Props {
  /** Page title without the site suffix. Omit on the home page. */
  title?: string;
  description: string;
  /** Locale-less path of this page, e.g. `/services/`. */
  path: string;
  locale?: LocaleCode;
  /** Absolute or root-relative URL of the share image. */
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  publishedTime?: Date;
  modifiedTime?: Date;
}

const {
  title,
  description,
  path,
  locale = DEFAULT_LOCALE,
  image = '/og/default.png',
  type = 'website',
  noindex = false,
  publishedTime,
  modifiedTime,
} = Astro.props;

const t = useTranslations(locale);
const localeDefinition = getLocale(locale);

const siteName = t('site.name');

/**
 * The home page has no page title of its own, so it falls back to a short
 * positioning phrase rather than the full tagline — the tagline is a
 * sentence, and prepending the brand pushed the result past 70 characters,
 * which search results truncate.
 */
const fullTitle = t('site.titleTemplate').replace('%s', title ?? t('site.homeTitle'));

const canonical = new URL(localePath(locale, path), Astro.site);
const imageUrl = new URL(image, Astro.site);

/** BCP-47 tags in the underscore form Open Graph expects (`en_US` style). */
const ogLocale = localeDefinition.htmlLang.replace('-', '_');

const alternates = IS_MULTILINGUAL
  ? PUBLISHED_LOCALES.map((code) => ({
      hreflang: getLocale(code).htmlLang,
      href: new URL(localePath(code, path), Astro.site).href,
    }))
  : [];
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical.href} />

{noindex && <meta name="robots" content="noindex, nofollow" />}

{
  alternates.map((alternate) => (
    <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />
  ))
}
{
  IS_MULTILINGUAL && (
    <link rel="alternate" hreflang="x-default" href={new URL(localePath(DEFAULT_LOCALE, path), Astro.site).href} />
  )
}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={siteName} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical.href} />
<meta property="og:image" content={imageUrl.href} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content={ogLocale} />

{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl.href} />
