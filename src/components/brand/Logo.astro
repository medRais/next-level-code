---
/**
 * The Next Level Code lockup.
 *
 * Reproduced as live text in the display face rather than as a bitmap: it
 * stays crisp at any size, inverts on ink surfaces via `currentColor`, and
 * carries a real accessible name. The "E" is replaced by the ≡ mark, exactly
 * as in the original wordmark.
 *
 * Colour comes from the surrounding context — set `text-ink` on light
 * sections and `text-porcelain` on dark ones. There is no separate dark
 * asset to keep in sync.
 */

import Glyph from './Glyph.astro';

interface Props {
  /** Cap height of the wordmark. Everything else scales from it. */
  size?: string;
  /** Hides the "Level Code" line — for tight spots such as a compact header. */
  wordmarkOnly?: boolean;
  /** Plays the hero opening sequence on the ≡ bars. Home hero only. */
  animated?: boolean;
  class?: string;
}

const { size = '1.375rem', wordmarkOnly = false, animated = false, class: className } = Astro.props;
---

<span
  class:list={['logo', className]}
  style={`--logo-size: ${size};`}
  role="img"
  aria-label="Next Level Code"
>
  <span class="logo__wordmark" aria-hidden="true">
    <span class="logo__letter">N</span>
    <Glyph size="calc(var(--logo-size) * 0.55)" class="logo__e" animated={animated} />
    <span class="logo__letter">X</span>
    <span class="logo__letter">T</span>
  </span>

  {!wordmarkOnly && <span class="logo__sub" aria-hidden="true">Level Code</span>}
</span>

<style>
  .logo {
    display: inline-flex;
    flex-direction: column;
    align-items: start;
    gap: calc(var(--logo-size) * 0.2);
    font-family: var(--font-display);
    color: currentColor;
    line-height: 1;
    /* The wordmark must never be synthesised into a fake weight if the
       variable font has not loaded yet. */
    font-synthesis: none;
  }

  .logo__wordmark {
    display: flex;
    align-items: center;
    /* Gap rather than letter-spacing: no phantom trailing space to correct,
       and the ≡ sits in the run as a real sibling. The ratio is measured off
       the original wordmark, where the gaps run to about a quarter of the
       cap height. */
    gap: calc(var(--logo-size) * 0.26);
    font-size: var(--logo-size);
    font-weight: 300;
    line-height: 1;
  }

  .logo__letter {
    display: block;
    line-height: 1;
  }

  /* Optical alignment: the letters are positioned by their line box, the mark
     by its own height, so the two do not agree by default. This nudge lines
     the bars up with the cap height of N, X and T. Tuned against the rendered
     lockup — adjust here if the display face is ever changed. */
  .logo__e {
    transform: translateY(calc(var(--logo-size) * -0.015));
  }

  .logo__sub {
    font-size: calc(var(--logo-size) * 0.46);
    font-weight: 300;
    /* Widens the second line to sit under the full width of the wordmark,
       as in the original lockup, where the two lines are near-flush. */
    letter-spacing: calc(var(--logo-size) * 0.082);
    /* letter-spacing leaves a phantom space after the final character; this
       cancels it so the line is optically flush with the wordmark. */
    margin-inline-end: calc(var(--logo-size) * -0.082);
    line-height: 1;
  }
</style>
