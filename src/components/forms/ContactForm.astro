---
/**
 * Contact form.
 *
 * Posts to Web3Forms, which accepts a plain form submission from a static
 * site — no backend, which is the hosting constraint. The access key is a
 * public identifier by design: it only authorises delivery to the mailbox it
 * is bound to, so it is safe in client-side markup.
 *
 * Progressive by construction. Without JavaScript the form still submits as
 * an ordinary POST and Web3Forms renders its own confirmation page; the
 * script only upgrades that to an inline result. If the request fails for any
 * reason, the visitor is given a mailto: fallback rather than a dead end.
 */

import Button from '../ui/Button.astro';
import { CONTACT_EMAIL, WEB3FORMS_ACCESS_KEY } from '../../data/company';
import { type LocaleCode } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';

interface Props {
  locale: LocaleCode;
  class?: string;
  [key: string]: unknown;
}

const { locale, class: className, ...rest }: Props = Astro.props;
const t = useTranslations(locale);
---

{/*
  Result copy travels with the markup as data attributes rather than living
  in the script, so the form stays translatable like the rest of the site.
*/}

<form
  class:list={['contact-form', className]}
  method="POST"
  action="https://api.web3forms.com/submit"
  data-contact-form
  data-fallback-email={CONTACT_EMAIL}
  data-copy-submitting={t('form.submitting')}
  data-copy-submit={t('form.submit')}
  data-copy-success-title={t('form.successTitle')}
  data-copy-success-body={t('form.successBody')}
  data-copy-error-title={t('form.errorTitle')}
  data-copy-error-body={t('form.errorBody')}
  data-copy-email-fallback={t('form.emailFallback')}
  {...rest}
>
  <input type="hidden" name="access_key" value={WEB3FORMS_ACCESS_KEY} />
  <input type="hidden" name="subject" value="New enquiry from nextlevelcode.tech" />
  <input type="hidden" name="from_name" value="Next Level Code website" />

  {/* Honeypot: bots fill it, people never see it. */}
  <input
    type="checkbox"
    name="botcheck"
    class="contact-form__honeypot"
    tabindex="-1"
    autocomplete="off"
    aria-hidden="true"
  />

  <div class="field">
    <label class="field__label" for="contact-name">
      {t('form.nameLabel')}
      <span class="field__required" aria-hidden="true">*</span>
    </label>
    <input
      class="field__input"
      id="contact-name"
      name="name"
      type="text"
      required
      autocomplete="name"
      placeholder={t('form.namePlaceholder')}
    />
  </div>

  <div class="field">
    <label class="field__label" for="contact-email">
      {t('form.emailLabel')}
      <span class="field__required" aria-hidden="true">*</span>
    </label>
    <input
      class="field__input"
      id="contact-email"
      name="email"
      type="email"
      required
      autocomplete="email"
      placeholder={t('form.emailPlaceholder')}
    />
  </div>

  <div class="field">
    <label class="field__label" for="contact-company">{t('form.companyLabel')}</label>
    <input
      class="field__input"
      id="contact-company"
      name="company"
      type="text"
      autocomplete="organization"
      placeholder={t('form.companyPlaceholder')}
    />
  </div>

  <div class="field">
    <label class="field__label" for="contact-need">
      {t('form.needLabel')}
      <span class="field__required" aria-hidden="true">*</span>
    </label>
    <textarea
      class="field__input field__input--area"
      id="contact-need"
      name="message"
      rows="5"
      required
      placeholder={t('form.needPlaceholder')}></textarea>
  </div>

  <div class="contact-form__actions">
    <Button type="submit" size="lg" data-submit>{t('form.submit')}</Button>
    <p class="contact-form__promise">{t('form.responsePromise')}</p>
  </div>

  {/*
    Announced to assistive technology the moment it is populated, so a
    screen-reader user learns the outcome without hunting for it.
  */}
  <div class="contact-form__result" data-result role="status" aria-live="polite" hidden></div>
</form>

<script>
  import { initContactForm } from '../../scripts/form';
  initContactForm();
</script>

<style>
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  /* Off-screen rather than display:none — some bots skip hidden inputs. */
  .contact-form__honeypot {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .field__label {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-ink);
  }

  .field__required {
    color: var(--color-cobalt);
  }

  .field__input {
    inline-size: 100%;
    padding: 0.8125rem 1rem;
    font-family: inherit;
    font-size: 1rem;
    color: var(--color-ink);
    background-color: var(--color-porcelain);
    border: 1px solid var(--color-hairline-strong);
    border-radius: var(--radius-hair);
    transition: border-color var(--duration-micro) var(--ease-swift);
  }

  .field__input::placeholder {
    color: var(--color-slate);
    opacity: 0.7;
  }

  .field__input:hover {
    border-color: var(--color-ink);
  }

  .field__input--area {
    resize: vertical;
    min-block-size: 8rem;
  }

  .contact-form__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem;
    margin-block-start: 0.5rem;
  }

  .contact-form__promise {
    margin: 0;
    font-size: 0.875rem;
    color: var(--color-slate);
  }

  .contact-form__result {
    padding: 1.25rem;
    border-radius: var(--radius-card);
    border: 1px solid var(--color-hairline-strong);
    font-size: 0.9375rem;
  }

  .contact-form__result[hidden] {
    display: none;
  }

  .contact-form__result[data-state='success'] {
    border-color: var(--color-cobalt);
    background-color: color-mix(in oklab, var(--color-cobalt) 6%, transparent);
  }

  .contact-form__result[data-state='error'] {
    border-color: var(--color-hairline-strong);
    background-color: color-mix(in oklab, var(--color-ink) 3%, transparent);
  }

  .contact-form__result :global(strong) {
    display: block;
    margin-block-end: 0.375rem;
    font-weight: 500;
    color: var(--color-ink);
  }

  .contact-form__result :global(a) {
    color: var(--color-cobalt);
  }
</style>
