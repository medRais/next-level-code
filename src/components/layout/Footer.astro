---
/**
 * Site footer on ink.
 *
 * Doubles as the full sitemap, which is what makes the mobile menu safe to
 * hide behind JavaScript: every route stays reachable without it.
 */

import Logo from '../brand/Logo.astro';
import Rule from '../ui/Rule.astro';
import { localePath, type LocaleCode } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';
import { COMPANY_NAV, LEGAL_NAV, RESOURCE_NAV, SERVICE_NAV } from '../../lib/navigation';

interface Props {
  locale: LocaleCode;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

/** Rendered at build time; the site rebuilds on every deploy. */
const year = new Date().getFullYear();

const columns = [
  { heading: t('footer.servicesHeading'), items: SERVICE_NAV },
  { heading: t('footer.companyHeading'), items: COMPANY_NAV },
  { heading: t('footer.resourcesHeading'), items: RESOURCE_NAV },
];
---

<footer class="footer">
  <div class="container-site footer__inner">
    <div class="footer__brand">
      <Logo size="1.5rem" />
      <p class="footer__pitch">{t('footer.pitch')}</p>
      <Rule tone="ink" />
    </div>

    <div class="footer__columns">
      {
        columns.map((column) => (
          <nav class="footer__column" aria-label={column.heading}>
            <h2 class="footer__heading">{column.heading}</h2>
            <ul class="footer__list">
              {column.items.map((item) => (
                <li>
                  <a class="footer__link" href={localePath(locale, item.path)}>
                    {t(item.labelKey)}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>
  </div>

  <div class="container-site footer__bottom">
    <p class="footer__copyright">{t('footer.copyright', { year })}</p>
    <ul class="footer__legal">
      {
        LEGAL_NAV.map((item) => (
          <li>
            <a class="footer__link" href={localePath(locale, item.path)}>
              {t(item.labelKey)}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--color-ink);
    color: var(--color-mist);
    padding-block-start: clamp(3.5rem, 3rem + 2vw, 5.5rem);
  }

  .footer__inner {
    display: grid;
    gap: 3rem;
  }

  .footer__brand {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    color: var(--color-porcelain);
    max-inline-size: 26rem;
  }

  .footer__pitch {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-mist);
  }

  .footer__columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 2.5rem;
  }

  .footer__heading {
    margin: 0 0 1rem;
    font-family: var(--font-body);
    font-size: var(--text-eyebrow);
    font-weight: 500;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-porcelain);
  }

  .footer__list,
  .footer__legal {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer__link {
    font-size: 0.9375rem;
    color: var(--color-mist);
    text-decoration: none;
    transition: color var(--duration-micro) var(--ease-swift);
  }

  .footer__link:hover {
    color: var(--color-porcelain);
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-block-start: clamp(3rem, 2.5rem + 2vw, 4.5rem);
    padding-block: 1.5rem;
    border-block-start: 1px solid var(--color-hairline-dark);
  }

  .footer__copyright {
    margin: 0;
    font-size: 0.875rem;
  }

  .footer__legal {
    flex-direction: row;
    gap: 1.5rem;
  }

  @media (width >= 64rem) {
    .footer__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
      gap: 4rem;
    }
  }
</style>
