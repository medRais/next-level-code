---
/**
 * Sticky site header.
 *
 * Behaviour lives in src/scripts/header.ts: it retreats on downward scroll,
 * returns on upward scroll, and densifies once detached from the hero. All of
 * that is progressive — with JavaScript off the header is simply a normal
 * sticky bar.
 *
 * The mobile toggle uses the ≡ mark rather than a generic hamburger. The
 * brand already owns that shape, so there was no reason to introduce another.
 */

import Logo from '../brand/Logo.astro';
import Button from '../ui/Button.astro';
import LangSwitcher from './LangSwitcher.astro';
import { localePath, localePrefix, type LocaleCode } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';
import { PRIMARY_NAV, isActivePath } from '../../lib/navigation';

interface Props {
  locale: LocaleCode;
  /** Locale-less path of the current page. */
  path: string;
}

const { locale, path } = Astro.props;

const t = useTranslations(locale);
const prefix = localePrefix(locale);
const currentPath = localePath(locale, path);
---

<header class="header" data-site-header>
  <div class="container-site header__inner">
    <a href={localePath(locale, '/')} class="header__logo">
      <Logo size="1.375rem" />
    </a>

    <nav class="header__nav" aria-label={t('nav.ariaLabel')}>
      <ul class="header__list">
        {
          PRIMARY_NAV.map((item) => {
            const active = isActivePath(currentPath, item.path, prefix);
            return (
              <li>
                <a
                  href={localePath(locale, item.path)}
                  class:list={['header__link', active && 'is-active']}
                  aria-current={active ? 'page' : undefined}
                >
                  {t(item.labelKey)}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <div class="header__actions">
      <LangSwitcher locale={locale} path={path} />
      {/* Wrapped, not styled through a passed class: a class handed to a
          child component does not inherit this file's style scope, so the
          rule hiding this on mobile would never match. */}
      <div class="header__cta">
        <Button href={localePath(locale, '/contact/')}>{t('cta.primary')}</Button>
      </div>

      <button
        type="button"
        class="header__toggle"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="site-menu"
        aria-label={t('nav.openMenu')}
        data-close-label={t('nav.closeMenu')}
      >
        <span class="header__toggle-bars" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>
      </button>
    </div>
  </div>

  <div class="header__panel" id="site-menu" data-menu-panel hidden>
    <nav class="container-site header__panel-inner" aria-label={t('nav.ariaLabel')}>
      <ul class="header__panel-list">
        {
          PRIMARY_NAV.map((item) => {
            const active = isActivePath(currentPath, item.path, prefix);
            return (
              <li>
                <a
                  href={localePath(locale, item.path)}
                  class:list={['header__panel-link', active && 'is-active']}
                  aria-current={active ? 'page' : undefined}
                >
                  {t(item.labelKey)}
                </a>
              </li>
            );
          })
        }
      </ul>
      <div class="header__panel-cta">
        <Button href={localePath(locale, '/contact/')} size="lg">{t('cta.primary')}</Button>
      </div>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    inset-block-start: 0;
    z-index: 50;
    background-color: color-mix(in oklab, var(--color-porcelain) 88%, transparent);
    border-block-end: 1px solid transparent;
    transition:
      transform 320ms var(--ease-precise),
      border-color 320ms var(--ease-swift),
      backdrop-filter 320ms var(--ease-swift);
  }

  /* Detached from the hero: the surface firms up so content scrolling
     underneath stays readable. */
  .header.is-detached {
    border-block-end-color: var(--color-hairline);
    backdrop-filter: saturate(180%) blur(12px);
  }

  /* Retreat on downward scroll. Transform only. */
  .header.is-hidden {
    transform: translateY(-100%);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    min-block-size: 4.5rem;
  }

  .header__logo {
    display: inline-flex;
    color: var(--color-ink);
    text-decoration: none;
    flex-shrink: 0;
  }

  .header__nav {
    display: none;
    flex: 1;
  }

  .header__list {
    display: flex;
    align-items: center;
    gap: 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .header__link {
    position: relative;
    display: inline-block;
    padding-block: 0.25rem;
    font-size: 0.9375rem;
    color: var(--color-slate);
    text-decoration: none;
    transition: color var(--duration-micro) var(--ease-swift);
  }

  /* Underline that draws in from the reading edge. */
  .header__link::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    block-size: 1px;
    background-color: currentColor;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform var(--duration-hover) var(--ease-precise);
  }

  :global([dir='rtl']) .header__link::after {
    transform-origin: right center;
  }

  .header__link:hover {
    color: var(--color-ink);
  }

  .header__link:hover::after {
    transform: scaleX(1);
  }

  .header__link.is-active {
    color: var(--color-ink);
  }

  .header__link.is-active::after {
    background-color: var(--color-cobalt);
    transform: scaleX(1);
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-shrink: 0;
  }

  .header__cta {
    display: none;
  }

  /* ── Mobile toggle: the ≡ mark ─────────────────────────────────────────── */
  .header__toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    margin-inline-end: -0.75rem;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--color-ink);
  }

  .header__toggle-bars {
    position: relative;
    display: block;
    inline-size: 1.25rem;
    block-size: 0.875rem;
  }

  .header__toggle-bars span {
    position: absolute;
    inset-inline: 0;
    block-size: 2px;
    background-color: currentColor;
    transition: transform 240ms var(--ease-precise), opacity 160ms var(--ease-swift);
  }

  .header__toggle-bars span:nth-child(1) {
    inset-block-start: 0;
  }
  .header__toggle-bars span:nth-child(2) {
    inset-block-start: calc(50% - 1px);
  }
  .header__toggle-bars span:nth-child(3) {
    inset-block-end: 0;
  }

  /* Open: the outer bars cross, the middle one fades. */
  .header[data-menu-open='true'] .header__toggle-bars span:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }
  .header[data-menu-open='true'] .header__toggle-bars span:nth-child(2) {
    opacity: 0;
  }
  .header[data-menu-open='true'] .header__toggle-bars span:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* ── Mobile panel ──────────────────────────────────────────────────────── */
  .header__panel {
    border-block-start: 1px solid var(--color-hairline);
    background-color: var(--color-porcelain);
  }

  .header__panel[hidden] {
    display: none;
  }

  .header__panel-inner {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding-block: 1.5rem 2rem;
  }

  .header__panel-list {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .header__panel-link {
    display: block;
    padding-block: 0.75rem;
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 300;
    color: var(--color-ink);
    text-decoration: none;
    border-block-end: 1px solid var(--color-hairline);
  }

  .header__panel-link.is-active {
    color: var(--color-cobalt);
  }

  .header__panel-cta {
    display: flex;
    align-self: start;
  }

  /* ── Desktop ───────────────────────────────────────────────────────────── */
  @media (width >= 64rem) {
    .header__nav {
      display: flex;
      justify-content: center;
    }

    .header__cta {
      display: inline-flex;
    }

    .header__toggle,
    .header__panel {
      display: none;
    }
  }
</style>
